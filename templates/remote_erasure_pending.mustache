{{!
    @template local_coursedynamicrules/remote_erasure_pending

    The erasures of AI requests on the course service pending longer than the configured days,
    shown read-only on the plugin settings page (CDR-PRIV-001-R2). Only counts and dates: no thread
    id and no client request id is shown.

    Context variables required for this template:
    * description - string, what the list is, already translated
    * hasitems - bool, whether any erasure is overdue
    * count - int, how many students are listed in total
    * items - array, one entry per student shown
        * userid - int
        * requests - int, the requests pending erasure
        * firstrequested - string, when the erasure was first asked for, formatted
        * attempts - int, the consecutive failed attempts
        * lastfailure - string, the last failed attempt, formatted, or empty
    * more - int, the students not shown, or 0

    Example context (json):
    {
        "description": "Students whose erasure has been pending for more than 7 day(s).",
        "hasitems": true,
        "count": 1,
        "items": [{"userid": 5, "requests": 2, "firstrequested": "1 January 2026", "attempts": 4,
            "lastfailure": "8 January 2026"}],
        "more": 0
    }
}}
<div class="local-coursedynamicrules-remote-erasure-pending">
    <p>{{description}}</p>
    {{#hasitems}}
        <p>{{#str}} remoteerasurepending_summary, local_coursedynamicrules, {{count}} {{/str}}</p>
        <table class="table table-sm generaltable">
            <thead>
                <tr>
                    <th scope="col">{{#str}} remoteerasurepending_user, local_coursedynamicrules {{/str}}</th>
                    <th scope="col">{{#str}} remoteerasurepending_requests, local_coursedynamicrules {{/str}}</th>
                    <th scope="col">{{#str}} remoteerasurepending_firstrequested, local_coursedynamicrules {{/str}}</th>
                    <th scope="col">{{#str}} remoteerasurepending_attempts, local_coursedynamicrules {{/str}}</th>
                    <th scope="col">{{#str}} remoteerasurepending_lastfailure, local_coursedynamicrules {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#items}}
                    <tr>
                        <td>{{userid}}</td>
                        <td>{{requests}}</td>
                        <td>{{firstrequested}}</td>
                        <td>{{attempts}}</td>
                        <td>{{lastfailure}}</td>
                    </tr>
                {{/items}}
            </tbody>
        </table>
        {{#more}}
            <p>{{#str}} remoteerasurepending_more, local_coursedynamicrules, {{more}} {{/str}}</p>
        {{/more}}
    {{/hasitems}}
    {{^hasitems}}
        <p>{{#str}} remoteerasurepending_none, local_coursedynamicrules {{/str}}</p>
    {{/hasitems}}
</div>
